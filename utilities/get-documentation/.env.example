# Credenciales de la cuenta Atlassian (compartidas por Confluence y Jira Cloud)
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_USER_EMAIL=tu-email@empresa.com
ATLASSIAN_API_TOKEN=xxxxx

# Subdominio de tu sitio Atlassian: si tu URL es https://tuempresa.atlassian.net, pon "tuempresa"
ATLASSIAN_SITE=tuempresa
# Directorio de salida para los archivos descargados
OUTPUT_DIR=./output

# IDs de campos custom Jira que contienen requisitos, separados por coma (opcional).
# Sin configurar, se incluyen campos custom textuales y se evalúa su relevancia durante el análisis.
# JIRA_REQUIREMENT_FIELD_IDS=customfield_10001,customfield_10002
