# =====================================================
# PLANTILLA DE CONFIGURACION XRAY / JIRA CLOUD
# =====================================================
# Copia este archivo como .env.xray y rellena con tus credenciales reales.
# NUNCA commitees .env.xray al repositorio.
#
# Para DESACTIVAR la integracion con XRay, establece:
#   XRAY_ENABLED=false
# O simplemente no crees el archivo .env.xray.
# =====================================================

XRAY_ENABLED=true

# Credenciales de la API de XRay Cloud
# Obtener en: Xray Cloud -> API Keys
XRAY_CLIENT_ID=tu_xray_client_id
XRAY_CLIENT_SECRET=tu_xray_client_secret
XRAY_BASE_URL=https://xray.cloud.getxray.app

# Credenciales de Jira Cloud
# Obtener el token en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://tu-instancia.atlassian.net
JIRA_USER_EMAIL=tu_email@empresa.com
JIRA_API_TOKEN=tu_jira_api_token
JIRA_PROJECT_KEY=CLAVE_PROYECTO

# Tipo de link usado para vincular un Test con su Historia de Usuario (etiqueta @related:ID en el .feature)
# Por defecto "Test" (link type estandar de XRay: inward "is tested by" / outward "tests").
# Si tu instancia usa otro nombre, consultalo con GET /rest/api/3/issueLinkType. Opcional: solo aplica si algun escenario usa @related:ID.
XRAY_STORY_LINK_TYPE=Test
